# Studify Server Environment Variables

# Port for the backend HTTP server (default: 3001)
PORT=3001

# Master Google Gemini API Key for server AI proxy
# Get your key at: https://aistudio.google.com/app/apikey
# Once set here, students using the app NEVER need to provide their own API key!
GEMINI_API_KEY=

# Cryptographic secret for signing session JWT tokens
# Use any strong random 32+ character string
JWT_SECRET=studify_super_secret_jwt_key_2026_change_in_production

# Optional custom SQLite database path (defaults to server/data/studify.sqlite)
# DATABASE_PATH=
