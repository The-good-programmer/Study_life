# Studify Server Environment Variables

# Port for the backend HTTP server (default: 3001)
PORT=3001

# Master Google Gemini API Key for the server AI proxy.
# Get your key at: https://aistudio.google.com/app/apikey
# Only signed-in users can use the proxy; guests use their own key or the offline fallback.
GEMINI_API_KEY=

# Per-user daily limit on shared AI requests (default: 200)
# AI_DAILY_QUOTA=200

# Secret for signing login tokens. REQUIRED in production (min 32 chars).
# In development a random secret is generated per run if this is empty.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google OAuth Web Client ID — must match VITE_GOOGLE_CLIENT_ID in the frontend.
# Used to verify Google sign-in ID tokens. Google sign-in on the server is disabled if empty.
GOOGLE_CLIENT_ID=

# Comma-separated list of browser origins allowed to call the API (CORS).
# Defaults to http://localhost:5173,http://localhost:5175
ALLOWED_ORIGINS=

# Optional custom SQLite database path (defaults to server/data/studify.sqlite)
# DATABASE_PATH=
